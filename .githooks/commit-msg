#!/bin/sh
#
# commit-msg 乱码拦截：防止 AI 工具（弱模型）产出乱码提交消息的强制底线。
# 检查项：合法 UTF-8 / 无 U+FFFD 替换符 / 无经典 GBK↔UTF-8 乱码子串 / 无零宽与控制字符。
# 逃生口：确实需要提交非 UTF-8 历史内容时，用 ALLOW_DIRTY_ENCODING=1 git commit ... 跳过。
#

msgfile="$1"

fail() {
    echo "" >&2
    echo "✖ 提交被拦截：commit message 编码异常（疑似乱码）" >&2
    echo "" >&2
    echo "  原因: $1" >&2
    echo "" >&2
    echo "  修复: 请用标准 UTF-8 重写提交消息（中文/英文均可）。" >&2
    echo "        AI 工具生成的消息被拦截时，换用: git commit --file=<UTF-8编码的消息文件>" >&2
    echo "        确属历史遗留非 UTF-8 内容: ALLOW_DIRTY_ENCODING=1 git commit ..." >&2
    exit 1
}

# 逃生口：显式声明时放行
[ "$ALLOW_DIRTY_ENCODING" = "1" ] && exit 0

# 1. 整体必须是合法 UTF-8。Windows 控制台下 AI 输出 GBK 混入时，iconv 直接失败
if ! iconv -f UTF-8 -t UTF-8 "$msgfile" >/dev/null 2>&1; then
    fail "消息不是合法 UTF-8（疑似混入 GBK 等其他编码字节）"
fi

# 2. U+FFFD 替换符：说明乱码在写入前就已发生（EF BF BD）
if LC_ALL=C grep -q $'\xEF\xBF\xBD' "$msgfile"; then
    fail "消息包含替换字符 U+FFFD（�），即已产生的乱码"
fi

# 3. 经典乱码子串：GBK/UTF-8 互转错误的典型产物。
#    锟斤拷 = 连续 U+FFFD 再编码的结果；鎴/鐨勶/涓嶅 等是常用汉字 UTF-8 字节被按 GBK 解读的结果，
#    正常中文消息中不会出现这些字符，误报率极低
if grep -q -e '锟斤拷' -e '锟秸' -e '烫烫' -e '鎴' -e '鐨勶' -e '涓嶅' -e '锛' "$msgfile"; then
    fail "消息包含典型 GBK/UTF-8 乱码子串（如 锟斤拷 等）"
fi

# 4. 不可见污染字符：模型偶发输出的零宽字符与控制符，肉眼难察觉但属脏数据。
#    零宽空格 U+200B/E2 80 8B、BOM U+FEFF/EF BB BF、左至右标记 U+200E/E2 80 8E 用字节序列匹配；
#    控制字符用 tr 兜底：删除允许的字节（\t\n\r 及全部可见字节，UTF-8 多字节序列的高位字节
#    落在 \200-\377 也一并放行），若还有剩余即存在 C0 控制符（\x00-\x08\x0B\x0C\x0E-\x1F\x7F）
if LC_ALL=C grep -q -e $'\xE2\x80\x8B' -e $'\xEF\xBB\xBF' -e $'\xE2\x80\x8E' "$msgfile" \
   || LC_ALL=C tr -d '\11\12\15\40-\176\200-\377' < "$msgfile" | LC_ALL=C grep -q .; then
    fail "消息包含零宽字符 / BOM / 控制字符"
fi

exit 0
