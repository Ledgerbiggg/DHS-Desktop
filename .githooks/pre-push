#!/usr/bin/env bash
# Git pre-push hook: 推送前校验构建（.NET）
# 版本号由 scripts/release.ps1 统一管理，此处不做版本自增

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR" || exit 1

echo "[pre-push] 运行构建检查 (dotnet build)..."
OUTPUT=$(dotnet build Dsh.sln -v q --nologo 2>&1)
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "========================================"
  echo "  构建失败，推送已阻止"
  echo "========================================"
  echo ""
  echo "$OUTPUT"
  echo ""
  echo "请修复以上错误后重新推送。"
  exit 1
fi

echo "[pre-push] 构建检查通过"
exit 0
