<ui:FluentWindow x:Class="Dsh.Views.SettingsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    WindowBackdropType="Mica"
                    WindowStartupLocation="CenterOwner"
                    ExtendsContentIntoTitleBar="True"
                    Title="设置"
                    Width="520" Height="480"
                    MinWidth="440" MinHeight="360"
                    ResizeMode="NoResize"
                    PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="设置" CloseWindowByDoubleClickOnIcon="True" />

        <!-- 设置内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,20" MaxWidth="460" HorizontalAlignment="Left" Focusable="True">
                <TextBlock Style="{StaticResource PanelTitleStyle}" Text="设置" />
                <TextBlock Style="{StaticResource PanelSubStyle}" Margin="0,4,0,0"
                           Text="开机自启动与快捷键管理。" />

                <!-- 开机自启 -->
                <TextBlock Style="{StaticResource FormLabelStyle}" Text="开机自启" Margin="0,20,0,8" />
                <CheckBox Content="开机自动启动 DeepSeek" IsChecked="{Binding AutoStart}" />

                <!-- 快捷键设置 -->
                <TextBlock Style="{StaticResource FormLabelStyle}" Text="快捷键" Margin="0,20,0,8" />
                <TextBlock Style="{StaticResource FormHelpStyle}"
                           Text="全局快捷键，用于呼出/隐藏主窗口。点击「录制」后按下组合键（必须含修饰键），按 Esc 取消。" />

                <!-- 当前快捷键显示 + 录制按钮 -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource ApplicationBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                       Text="{Binding HotkeyDisplay}" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Text" Value="&#x1F534; 请按键…" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="1"
                            Command="{Binding RecordCommand}"
                            Style="{StaticResource MiniPrimaryButtonStyle}"
                            Padding="18,10" VerticalAlignment="Center">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="录制" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="Text" Value="停止" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>

                <!-- 保存按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button Style="{StaticResource MiniPrimaryButtonStyle}" Command="{Binding SaveCommand}"
                            Content="保存" Padding="24,8" />
                </StackPanel>

                <!-- 检查更新 -->
                <TextBlock Style="{StaticResource FormLabelStyle}" Text="关于" Margin="0,24,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <Button Style="{StaticResource MiniButtonStyle}" Command="{Binding CheckCommand}"
                            Content="检查更新" Padding="18,8" />
                </StackPanel>
                <!-- 更新状态文本 -->
                <TextBlock Margin="0,8,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding UpdateStatusText}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"
                           TextWrapping="Wrap" />

                <!-- 版本信息 -->
                <TextBlock Margin="0,20,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="当前版本：" />
                    <Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
