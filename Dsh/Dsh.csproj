<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Dsh</RootNamespace>
    <AssemblyName>Dsh</AssemblyName>
    <Version>0.1.0</Version>
    <!-- 应用图标：嵌入 exe -->
    <ApplicationIcon>Assets\deepseek-dark_48x48.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Prism.Unity" Version="8.1.97" />
    <PackageReference Include="WPF-UI" Version="4.0.0" />
  </ItemGroup>

  <!-- 应用图标与资源图片：打包进 exe -->
  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

  <!-- 托盘 .ico：作为内容复制到输出目录，供 NotifyIcon 从文件系统加载 -->
  <ItemGroup>
    <Content Include="Assets\deepseek-dark_48x48.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 版本说明文件：复制到输出目录 -->
  <ItemGroup>
    <Content Include="version.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
