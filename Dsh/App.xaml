<p:PrismApplication x:Class="Dsh.App"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="http://prismlibrary.com/"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:converter="clr-namespace:Dsh.Converter">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 通用值转换器 -->
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <converter:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisConverter" />

            <!-- 全局字体：作用于所有 TextBlock，避免默认 Segoe UI 中文回退不一致 -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI Fluent 主题基座 -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <!-- 自定义样式 -->
                <ResourceDictionary Source="Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</p:PrismApplication>
